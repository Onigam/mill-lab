{
  "name": "lab-template",
  "private": true,
  "version": "0.1.0",
  "description": "Template of an interactive 3D energy lab built on @onigam/lab-kit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.md\" \"docs/*.md\" \"scripts/*.mjs\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.md\" \"docs/*.md\" \"scripts/*.mjs\" \"tools/**/*.mjs\"",
    "kit:bump": "node scripts/kit-bump.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@onigam/lab-kit": "github:Onigam/lab-kit#v0.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
